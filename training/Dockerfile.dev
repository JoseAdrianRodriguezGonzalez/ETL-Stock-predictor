

FROM python:3.12-slim


FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Copiar definición de dependencias
COPY training/pyproject.toml training/uv.lock training/README.md ./

# Instalar dependencias, excepto PyTorch
RUN uv sync --locked \
    --no-dev \
    --no-install-project \
    --no-install-package torch

# Instalar PyTorch CPU
RUN uv pip install \
    --python /app/.venv/bin/python \
    torch \
    --index-url https://download.pytorch.org/whl/cpu

# Incorporar código fuente y configuraciones
COPY training/src ./src
COPY training/configs ./configs

# Instalar el proyecto sin modificar la instalación de PyTorch
RUN uv sync --locked \
    --no-dev \
    --no-install-package torch

ENV PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["training"]

CMD ["--config", "configs/lstm.yaml"]

