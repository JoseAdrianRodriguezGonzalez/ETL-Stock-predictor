

name: "sp500_forecasting"
backend: "onnxruntime"

max_batch_size: 32

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [30, 6]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [0]
  }
]
